# Server
PORT=8000

# The Python AI microservice (ai-service/)
AI_SERVICE_URL=http://localhost:8001

# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub personal access token (github.com/settings/tokens) - needed for 5000 req/hr instead of 60
