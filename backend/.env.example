# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (get a key at console.anthropic.com)
ANTHROPIC_API_KEY=

# GitHub personal access token (github.com/settings/tokens) - needed for 5000 req/hr instead of 60
GITHUB_TOKEN=

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
